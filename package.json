{
  "name": "front-start",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.7",
    "katex": "^0.19.0",
    "markstream-vue": "^2.0.20",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "remend": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@curev/eslint-config": "^0.6.2",
    "@types/node": "^24.12.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "less": "^4.9.1",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "unocss-preset-block": "^0.1.0",
    "unocss-preset-palette": "^0.4.0",
    "vite": "^8.3.4",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "overrides": {
      "vue": "$vue"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8",
        "vue-router": "5"
      }
    }
  }
}
